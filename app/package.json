    "@nutus/core": "workspace:*",
    "@nutus/report": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "typescript": "^5.9.0",
    "vite": "^8",
    "vitest": "^5.1.0"
